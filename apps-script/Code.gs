/**
 * MSM Unify leadership applications: backend.
 *
 * Runs as a Google Apps Script web app. For every application from the site it:
 *   1. checks the data and guards against abuse and double submits,
 *   2. saves the resume to a private Drive folder,
 *   3. adds one row to the "Applications" tab of the Google Sheet,
 *   4. emails HR: who applied, for which position, their email and phone, the resume attached,
 *   5. emails the candidate a personal note about the exact seat they chose.
 *
 * Thanks.gs (generated by build/build.py) holds the HR address and the per-seat copy.
 * Setup: see README.md in this folder.
 */
var CONFIG = {
  SHEET_ID: "1v5za_peLtbplmglzCSp5aNpYAah1ft4OG-1rE02Yn9A",  // "MSM Unify Leadership Applications"
  SHEET_TAB: "Applications",
  FOLDER_ID: "1xSaAah8SCFWXowiJceBjfmhh6c1sHqDg",            // "MSM Unify Leadership Applications (Resumes)"
  MAX_BYTES: 5 * 1024 * 1024,
  MAX_PER_EMAIL: 4,        // submissions allowed per email address in 6 hours
  SENDER_NAME: "MSM Unify HR",
  LOGO_URL: "https://msmunifyportal.blob.core.windows.net/msmunifyportal/2025/02/Logo.png"
};

var HEADERS = ["Reference", "Submitted", "Seat applied for", "Name", "Email", "Phone", "Location", "Current title", "Current company",
  "Experience (years)", "Notice period", "LinkedIn", "Portfolio", "Heard about us via", "First 90 days answer", "Resume",
  "Status", "Owner", "Notes", "Email delivery"];
var STATUS_LIST = ["New", "Acknowledged", "In conversation", "Interview", "Offer", "Hired", "Not moving forward", "On hold"];
var COL = { REF: 1, SUBMITTED: 2, SEAT: 3, NAME: 4, EMAIL: 5, PHONE: 6, RESUME: 16, STATUS: 17, DELIVERY: 20 };

/* ------------------------------------------------------------------ web app */

function doGet() {
  return out_({ ok: true, service: "MSM Unify leadership applications", seats: Object.keys(THANKS).length });
}

function doPost(e) {
  try {
    var body = JSON.parse(e.postData.contents);
    var result = processApplication_(body);
    return out_(result);
  } catch (err) {
    console.error(err);
    return out_({ ok: false, error: "Could not process the application" });
  }
}

function processApplication_(body) {
  var v = validate_(body);
  if (v.error) return { ok: false, error: v.error };
  var d = v.d, ref = v.ref, cache = CacheService.getScriptCache();

  // Same person, same seat, within 10 minutes: treat as a double click and do not repeat anything.
  var dupKey = "d:" + d.email.toLowerCase() + "|" + d.role;
  if (cache.get(dupKey)) return { ok: true, ref: cache.get(dupKey), duplicate: true };

  // Light abuse guard: a few submissions per address per 6 hours.
  var rlKey = "n:" + d.email.toLowerCase(), n = Number(cache.get(rlKey) || 0);
  if (n >= CONFIG.MAX_PER_EMAIL) return { ok: false, error: "Too many applications from this address. Please try again later." };
  cache.put(rlKey, String(n + 1), 21600);

  // 1. Resume to Drive
  var fileUrl = "", blob = null;
  if (v.r) {
    blob = Utilities.newBlob(Utilities.base64Decode(v.r.base64), v.r.type, ref + " - " + d.name + " - " + v.r.name);
    fileUrl = DriveApp.getFolderById(CONFIG.FOLDER_ID).createFile(blob).getUrl();
  }

  // 2. Row in the Sheet (locked so two applications never write to the same row)
  var lock = LockService.getScriptLock();
  lock.waitLock(25000);
  var ss, sh, row;
  try {
    ss = SpreadsheetApp.openById(CONFIG.SHEET_ID);
    sh = ss.getSheetByName(CONFIG.SHEET_TAB) || setupSheets_(ss);
    row = Math.max(sh.getLastRow(), 1) + 1;
    var values = [ref, new Date(), d.role, d.name, d.email, d.phone, d.location, d.title, d.company, d.experience, d.notice,
      d.linkedin, d.link, d.source, d["case"], "", "New", "", "", "Saved"];
    var formats = ["@", "dd mmm yyyy, hh:mm", "@", "@", "@", "@", "@", "@", "@", "@", "@", "@", "@", "@", "@", "General", "@", "@", "@", "@"];
    var range = sh.getRange(row, 1, 1, HEADERS.length);
    range.setNumberFormats([formats]);            // text format keeps "=" or "+" at the start of an answer from becoming a formula
    range.setValues([values]);
    if (fileUrl) sh.getRange(row, COL.RESUME).setFormula('=HYPERLINK("' + fileUrl.replace(/"/g, "") + '","Open resume")');
    SpreadsheetApp.flush();
  } finally {
    lock.releaseLock();
  }
  cache.put(dupKey, ref, 600);

  // 3. Emails. A failure here never loses the application: it is already in the Sheet.
  var sheetLink = ss.getUrl() + "#gid=" + sh.getSheetId() + "&range=A" + row;
  var delivery = [];
  try { sendToHr_(ref, d, fileUrl, blob, sheetLink); delivery.push("HR notified"); } catch (e1) { delivery.push("HR email failed: " + e1); }
  try { sendToCandidate_(ref, d); delivery.push("Candidate emailed"); } catch (e2) { delivery.push("Candidate email failed: " + e2); }
  sh.getRange(row, COL.DELIVERY).setValue(delivery.join(". "));
  return { ok: true, ref: ref };
}

/* --------------------------------------------------------------- validation */

function validate_(body) {
  if (!body || !body.data) return { error: "Missing data" };
  var src = body.data, d = {};
  var limits = { name: 120, email: 160, phone: 40, location: 120, title: 140, company: 140, experience: 40, notice: 40, linkedin: 300, link: 300, source: 80, "case": 1500, role: 140 };
  for (var k in limits) d[k] = String(src[k] == null ? "" : src[k]).replace(/\s+/g, k === "case" ? " " : " ").trim().slice(0, limits[k]);
  if (src["case"]) d["case"] = String(src["case"]).replace(/\r/g, "").trim().slice(0, 1500);
  if (!d.name || !d.email || !d.role || !d.phone || !d["case"]) return { error: "Missing required fields" };
  if (!THANKS[d.role]) return { error: "Unknown seat" };
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(d.email)) return { error: "Invalid email address" };
  if (d.phone.replace(/\D/g, "").length < 8) return { error: "Invalid phone number" };
  if (d.linkedin && !/^https?:\/\//i.test(d.linkedin)) return { error: "Invalid LinkedIn link" };
  if (d.link && !/^https?:\/\//i.test(d.link)) return { error: "Invalid portfolio link" };
  var ref = /^LDR-\d{8}-[A-Z0-9]{4}$/.test(String(body.ref || "")) ? body.ref : "LDR-" + Utilities.formatDate(new Date(), "Asia/Kolkata", "yyyyMMdd") + "-" + Math.random().toString(36).slice(2, 6).toUpperCase();
  var r = null, res = body.resume;
  if (res && res.base64) {
    if (!/\.(pdf|docx?)$/i.test(String(res.name || ""))) return { error: "Resume must be a PDF, DOC or DOCX file" };
    if (res.base64.length * 0.75 > CONFIG.MAX_BYTES) return { error: "Resume is larger than 5 MB" };
    r = { base64: res.base64, name: String(res.name).slice(0, 120), type: String(res.type || "application/octet-stream") };
  }
  return { d: d, ref: ref, r: r };
}

/* -------------------------------------------------------------- HR email */

function sendToHr_(ref, d, fileUrl, blob, sheetLink) {
  var when = Utilities.formatDate(new Date(), "Asia/Kolkata", "d MMM yyyy, h:mm a") + " IST";
  var big = function (label, valueHtml) {
    return '<tr><td style="padding:10px 0;border-bottom:1px solid #f0f0f0"><div style="font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:#9E9E9E;font-weight:700">' + label + '</div><div style="font-size:18px;font-weight:700;color:#111;margin-top:2px">' + valueHtml + "</div></td></tr>";
  };
  var small = function (label, v) {
    return '<tr><td style="padding:6px 16px 6px 0;color:#777;font-size:13px;white-space:nowrap;vertical-align:top">' + esc_(label) + '</td><td style="padding:6px 0;font-size:14px;color:#111">' + v + "</td></tr>";
  };
  var link = function (u) { return u ? '<a href="' + esc_(u) + '" style="color:#B3121A">' + esc_(u) + "</a>" : "Not provided"; };
  var html = '<div style="font-family:Arial,Helvetica,sans-serif;max-width:640px;margin:0 auto;color:#111">' +
    '<div style="background:#E8252A;color:#fff;padding:20px 26px"><div style="font-size:12px;letter-spacing:1.4px;text-transform:uppercase;opacity:.9">New leadership application</div>' +
    '<div style="font-size:24px;font-weight:800;line-height:1.2;margin-top:4px">' + esc_(d.name) + " applied for " + esc_(d.role) + "</div></div>" +
    '<div style="border:1px solid #efefef;border-top:0;padding:8px 26px 26px">' +
    '<table style="width:100%;border-collapse:collapse">' +
    big("Position", esc_(d.role)) + big("Name", esc_(d.name)) +
    big("Email", '<a href="mailto:' + esc_(d.email) + '" style="color:#B3121A;text-decoration:none">' + esc_(d.email) + "</a>") +
    big("Phone", '<a href="tel:' + esc_(d.phone.replace(/[^\d+]/g, "")) + '" style="color:#B3121A;text-decoration:none">' + esc_(d.phone) + "</a>") + "</table>" +
    '<p style="margin:22px 0 6px;font-weight:700">Profile</p><table style="border-collapse:collapse">' +
    small("Location", esc_(d.location)) + small("Current role", esc_(d.title) + " at " + esc_(d.company)) +
    small("Experience", esc_(d.experience) + " years") + small("Notice period", esc_(d.notice)) +
    small("LinkedIn", link(d.linkedin)) + small("Portfolio", link(d.link)) + small("Heard via", esc_(d.source || "Not provided")) +
    small("Reference", esc_(ref)) + small("Received", esc_(when)) + "</table>" +
    '<p style="margin:22px 0 6px;font-weight:700">What they would change in the first 90 days</p>' +
    '<div style="background:#f7f7f4;padding:16px;border-left:4px solid #E8252A;font-size:14px;line-height:1.6;white-space:pre-wrap">' + esc_(d["case"]) + "</div>" +
    '<table style="margin-top:24px;border-collapse:collapse"><tr>' +
    (fileUrl ? '<td style="padding-right:10px"><a href="' + esc_(fileUrl) + '" style="background:#111;color:#fff;text-decoration:none;font-weight:700;font-size:14px;padding:12px 18px;display:inline-block">Open resume</a></td>' : "") +
    '<td style="padding-right:10px"><a href="' + esc_(sheetLink) + '" style="background:#E8252A;color:#fff;text-decoration:none;font-weight:700;font-size:14px;padding:12px 18px;display:inline-block">Open in Sheet</a></td>' +
    '<td><a href="mailto:' + esc_(d.email) + '?subject=' + encodeURIComponent("Your application for " + d.role) + '" style="border:2px solid #111;color:#111;text-decoration:none;font-weight:700;font-size:14px;padding:10px 16px;display:inline-block">Reply to ' + esc_(d.name.split(" ")[0]) + "</a></td></tr></table>" +
    '<p style="margin-top:22px;color:#777;font-size:12px">The candidate has been sent a personal acknowledgement. Playbook target: first reply within ' + SLA_ACK_DAYS + " working days. Update the Status column in the Sheet as you go.</p></div></div>";
  var text = "New leadership application\n\nPosition: " + d.role + "\nName: " + d.name + "\nEmail: " + d.email + "\nPhone: " + d.phone +
    "\n\nLocation: " + d.location + "\nCurrent role: " + d.title + " at " + d.company + "\nExperience: " + d.experience + " years\nNotice period: " + d.notice +
    "\nLinkedIn: " + (d.linkedin || "Not provided") + "\nPortfolio: " + (d.link || "Not provided") + "\nHeard via: " + (d.source || "Not provided") +
    "\nReference: " + ref + "\n\nFirst 90 days:\n" + d["case"] + (fileUrl ? "\n\nResume: " + fileUrl : "") + "\nSheet: " + sheetLink;
  var opts = {
    to: HR_EMAIL,
    subject: d.name + " applied for " + d.role + " | " + ref,
    htmlBody: html, body: text, replyTo: d.email, name: "MSM Unify careers site"
  };
  if (blob) opts.attachments = [blob];
  MailApp.sendEmail(opts);
}

/* -------------------------------------------------------- candidate email */

function sendToCandidate_(ref, d) {
  var t = THANKS[d.role], first = d.name.split(" ")[0];
  var best = d.role === "Best fit, you decide";
  var seat = best ? "a leadership seat at MSM Unify" : d.role;
  var excerpt = d["case"].replace(/\s+/g, " ");
  if (excerpt.length > 260) excerpt = excerpt.slice(0, 257).replace(/\s+\S*$/, "") + "...";
  var received = Utilities.formatDate(new Date(), "Asia/Kolkata", "d MMMM yyyy");
  var h2 = function (s) { return '<p style="font-size:12px;letter-spacing:1.3px;text-transform:uppercase;color:#E8252A;font-weight:700;margin:26px 0 8px">' + s + "</p>"; };
  var stat = function (n, l) { return '<td style="width:25%;padding:14px 6px;text-align:center;border-right:1px solid #333"><div style="font-size:20px;font-weight:800;color:#fff">' + n + '</div><div style="font-size:11px;color:#bbb;margin-top:2px;line-height:1.3">' + l + "</div></td>"; };
  var steps = [
    "Within " + SLA_ACK_DAYS + " working days our talent team confirms we have read your application.",
    "If there is a fit, we talk about your background and this seat.",
    "Before the final stage you meet the Founder and Director or the hiring leader, and you receive the seat's written mandate: what you own, what success looks like in 12 months, and how you are measured.",
    "After every interview you hear the outcome within " + SLA_OUTCOME_DAYS + " working days, with one specific reason."
  ];
  var owns = (t.owns || []).map(function (o) { return '<tr><td style="vertical-align:top;padding:4px 10px 4px 0;color:#E8252A;font-weight:800">&rarr;</td><td style="padding:4px 0;font-size:15px;line-height:1.5">' + esc_(o) + "</td></tr>"; }).join("");
  var pre = first + ", your application for " + seat + " is in. Here is what we noticed, and what to prepare.";
  var html = '<div style="display:none;max-height:0;overflow:hidden;opacity:0">' + esc_(pre) + "</div>" +
    '<div style="background:#f4f4f4;padding:24px 0"><div style="font-family:Arial,Helvetica,sans-serif;max-width:620px;margin:0 auto;background:#fff;color:#111;line-height:1.6">' +
    '<div style="background:#E8252A;padding:22px 30px"><span style="display:inline-block;background:#fff;padding:8px 14px"><img src="' + CONFIG.LOGO_URL + '" alt="MSM Unify" height="34" style="display:block;height:34px"></span></div>' +
    '<div style="padding:30px 30px 8px">' +
    '<p style="font-size:28px;font-weight:800;line-height:1.15;margin:0 0 10px;letter-spacing:-0.5px">' + esc_(first) + ", we read this closely.</p>" +
    '<p style="font-size:16px;margin:0 0 6px">Your application for <b>' + esc_(seat) + "</b> reached our talent team on " + received + ". Applying from " + esc_(d.location) + ", as " + esc_(d.title) + " at " + esc_(d.company) + ".</p>" +
    h2("What you told us") +
    '<div style="border-left:4px solid #E8252A;background:#f7f7f4;padding:14px 16px;font-size:15px;font-style:italic">&ldquo;' + esc_(excerpt) + '&rdquo;</div>' +
    '<p style="font-size:14px;color:#555;margin:8px 0 0">That is the kind of specific answer we hope to hear. We will come back to it in your first conversation.</p>' +
    h2(best ? "How we will read you" : "The seat in one breath") +
    '<p style="font-size:16px;margin:0">' + esc_(t.lead) + "</p>" +
    (owns ? h2("What would land on your desk first") + '<table style="border-collapse:collapse;width:100%">' + owns + "</table>" : "") +
    (t.y1 ? h2("What success looks like in twelve months") + '<p style="font-size:15px;margin:0">' + esc_(t.y1) + "</p>" : "") +
    '<div style="background:#111;color:#fff;padding:18px 20px;margin:26px 0 4px"><div style="font-size:12px;letter-spacing:1.3px;text-transform:uppercase;color:#FCAF17;margin-bottom:6px;font-weight:700">For your first conversation</div><div style="font-size:17px;font-weight:700;line-height:1.4">' + esc_(t.ready) + "</div></div>" +
    "</div>" +
    '<table style="width:100%;border-collapse:collapse;background:#111;margin-top:22px"><tr>' +
    stat("225,000", "students supported") + stat("400", "institutional partners") + stat("30", "countries in operation") + '<td style="width:25%;padding:14px 6px;text-align:center"><div style="font-size:20px;font-weight:800;color:#E8252A">5,000,000</div><div style="font-size:11px;color:#bbb;margin-top:2px;line-height:1.3">learners by 2028</div></td>' +
    "</tr></table>" +
    '<div style="padding:8px 30px 30px">' + h2("What happens next") +
    '<table style="border-collapse:collapse;width:100%">' + steps.map(function (s, i) {
      return '<tr><td style="vertical-align:top;padding:5px 12px 5px 0;width:26px"><span style="display:inline-block;width:24px;height:24px;line-height:24px;text-align:center;background:#E8252A;color:#fff;font-weight:800;font-size:12px">' + (i + 1) + '</span></td><td style="padding:5px 0;font-size:14px;color:#333">' + esc_(s) + "</td></tr>";
    }).join("") + "</table>" +
    (t.url ? '<p style="margin:24px 0 0"><a href="' + esc_(t.url) + '" style="background:#E8252A;color:#fff;text-decoration:none;font-weight:700;font-size:15px;padding:14px 22px;display:inline-block">Read the full story of this seat</a></p>' : "") +
    '<p style="font-size:14px;color:#444;margin:26px 0 0">Reply to this email if you want to add something to your application or need an adjustment for the process. It comes straight to us.</p>' +
    '<p style="font-size:14px;margin:18px 0 0"><b>The MSM Unify HR team</b><br>' + esc_(HR_EMAIL) + ' | <a href="https://www.msmunify.com" style="color:#B3121A">www.msmunify.com</a> | Global Education, Building Careers</p>' +
    '<p style="font-size:11px;color:#999;margin:18px 0 0">Reference ' + esc_(ref) + ". You are receiving this because you applied through the MSM Unify leadership careers site.</p>" +
    "</div></div></div>";
  var text = first + ", we read this closely.\n\nYour application for " + seat + " reached our talent team on " + received + ".\n\nWhat you told us:\n\"" + excerpt + "\"\n\n" +
    t.lead + "\n\n" + ((t.owns && t.owns.length) ? "What would land on your desk first:\n- " + t.owns.join("\n- ") + "\n\n" : "") +
    (t.y1 ? "What success looks like in twelve months:\n" + t.y1 + "\n\n" : "") + "For your first conversation: " + t.ready +
    "\n\nWhat happens next:\n- " + steps.join("\n- ") + (t.url ? "\n\nThe full story of this seat: " + t.url : "") +
    "\n\nReference " + ref + "\n\nThe MSM Unify HR team\n" + HR_EMAIL + " | www.msmunify.com | Global Education, Building Careers";
  MailApp.sendEmail({
    to: d.email,
    subject: first + ", we have your application for " + seat,
    htmlBody: html, body: text, replyTo: HR_EMAIL, name: CONFIG.SENDER_NAME
  });
}

/* ------------------------------------------------- Sheet layout (optional) */

/** Creates the Applications and Dashboard tabs with the same layout the live Sheet already has.
 *  Runs automatically if the tab is missing. You can also run setup() from the editor. */
function setup() { setupSheets_(SpreadsheetApp.openById(CONFIG.SHEET_ID)); }

function setupSheets_(ss) {
  var red = "#E8252A", ink = "#111111";
  var sh = ss.getSheetByName(CONFIG.SHEET_TAB) || ss.insertSheet(CONFIG.SHEET_TAB, 0);
  sh.getRange(1, 1, 1, HEADERS.length).setValues([HEADERS]).setBackground(red).setFontColor("#ffffff").setFontWeight("bold").setFontFamily("Poppins").setVerticalAlignment("middle").setWrap(true);
  sh.setRowHeight(1, 44); sh.setFrozenRows(1); sh.setTabColor(red);
  var widths = [150, 150, 270, 180, 240, 150, 170, 200, 200, 125, 125, 220, 220, 170, 430, 160, 150, 140, 260, 260];
  widths.forEach(function (w, i) { sh.setColumnWidth(i + 1, w); });
  var body = sh.getRange(2, 1, 998, HEADERS.length);
  body.setFontFamily("Poppins").setFontSize(10).setVerticalAlignment("top");
  sh.getRange(2, COL.SUBMITTED, 998, 1).setNumberFormat("dd mmm yyyy, hh:mm");
  [3, 15, 19, 20].forEach(function (c) { sh.getRange(2, c, 998, 1).setWrap(true); });
  sh.getRange(2, 3, 998, 1).setFontWeight("bold");
  sh.getRange(2, COL.STATUS, 998, 1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(STATUS_LIST, true).setAllowInvalid(false).build());
  var colors = { "New": ["#FFF1CC", "#7A5A00"], "Acknowledged": ["#DCEBFA", "#0B4F8A"], "In conversation": ["#CFE2FF", "#0A3D91"], "Interview": ["#E9DDFB", "#4B2A96"],
    "Offer": ["#D4F1DC", "#14632D"], "Hired": ["#1E7B3A", "#FFFFFF"], "Not moving forward": ["#E6E6E6", "#555555"], "On hold": ["#FFE0CC", "#8A3B00"] };
  var rng = sh.getRange(2, COL.STATUS, 998, 1);
  sh.setConditionalFormatRules(Object.keys(colors).map(function (s) {
    return SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo(s).setBackground(colors[s][0]).setFontColor(colors[s][1]).setBold(true).setRanges([rng]).build();
  }));
  if (sh.getBandings().length === 0) sh.getRange(1, 1, 999, HEADERS.length).applyRowBanding(SpreadsheetApp.BandingTheme.LIGHT_GREY, true, false);
  if (!sh.getFilter()) sh.getRange(1, 1, 999, HEADERS.length).createFilter();

  var dash = ss.getSheetByName("Dashboard") || ss.insertSheet("Dashboard", 0);
  dash.setHiddenGridlines(true); dash.setTabColor(ink);
  dash.getRange("A1").setValue("Leadership applications").setFontSize(24).setFontWeight("bold").setFontColor(red);
  dash.getRange("A2").setValue("A live view of every application received through the leadership careers site.").setFontColor("#666666");
  dash.getRange("A4:C4").setValues([["Total applications", "Last 7 days", "Awaiting first reply"]]).setFontWeight("bold").setFontColor("#666666").setBackground("#efefef");
  dash.getRange("A5:C5").setFormulas([["=COUNTA(Applications!A2:A)", '=COUNTIFS(Applications!B2:B,">="&(NOW()-7))', '=COUNTIF(Applications!Q2:Q,"New")']]).setFontSize(28).setFontWeight("bold").setBackground("#efefef");
  dash.getRange("A7:D7").setValues([["Seat", "Applications", "New", "Interview or later"]]).setBackground(red).setFontColor("#ffffff").setFontWeight("bold");
  var seats = Object.keys(THANKS);
  seats.forEach(function (s, i) {
    var r = 8 + i, q = "Applications!$C$2:$C,$A" + r, st = "Applications!$Q$2:$Q";
    dash.getRange(r, 1).setValue(s);
    dash.getRange(r, 2, 1, 3).setFormulas([["=COUNTIF(" + q + ")", "=COUNTIFS(" + q + "," + st + ',"New")', "=COUNTIFS(" + q + "," + st + ',"Interview")+COUNTIFS(' + q + "," + st + ',"Offer")+COUNTIFS(' + q + "," + st + ',"Hired")']]);
  });
  var last = 7 + seats.length;
  dash.getRange(last + 1, 1, 1, 4).setFormulas([["Total", "=SUM(B8:B" + last + ")", "=SUM(C8:C" + last + ")", "=SUM(D8:D" + last + ")"]]).setFontWeight("bold").setBackground("#efefef");
  dash.getRange("F7:G7").setValues([["Status", "Count"]]).setBackground(ink).setFontColor("#ffffff").setFontWeight("bold");
  STATUS_LIST.forEach(function (s, i) { dash.getRange(8 + i, 6).setValue(s); dash.getRange(8 + i, 7).setFormula('=COUNTIF(Applications!$Q$2:$Q,$F' + (8 + i) + ")"); });
  dash.getRange(1, 1, 60, 8).setFontFamily("Poppins");
  dash.setColumnWidth(1, 420); dash.setColumnWidth(2, 130); dash.setColumnWidth(3, 130); dash.setColumnWidth(4, 150); dash.setColumnWidth(5, 30); dash.setColumnWidth(6, 170); dash.setColumnWidth(7, 90);
  return sh;
}

/* --------------------------------------------------------------- self test */

/** Run this once from the editor. It authorises the script, then sends a sample application
 *  through the whole pipeline: a Sheet row, a Drive file, the HR email and the candidate email.
 *  Both emails go to HR_EMAIL, so no outsider receives anything. */
function testSubmission() {
  var seat = Object.keys(THANKS)[0];
  var pdf = Utilities.base64Encode("%PDF-1.4 sample resume for the MSM Unify self test");
  var res = processApplication_({
    ref: "LDR-" + Utilities.formatDate(new Date(), "Asia/Kolkata", "yyyyMMdd") + "-TEST",
    data: { name: "Test Candidate", email: HR_EMAIL, phone: "+91 98100 00000", location: "Gurugram, India", title: "Chief Operating Officer", company: "Example Ltd",
      experience: "20 to 24", notice: "Up to 30 days", linkedin: "https://www.linkedin.com/in/example", link: "", source: "LinkedIn", role: seat,
      "case": "In the first 90 days I would map every market by revenue per student, choose the three corridors with the widest margin, and set a weekly review with one named owner for each gap." },
    resume: { name: "Test-Resume.pdf", type: "application/pdf", size: 60, base64: pdf }
  });
  console.log(JSON.stringify(res));
  return res;
}

/* ------------------------------------------------------------------ helpers */

function out_(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }
function esc_(s) { return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
