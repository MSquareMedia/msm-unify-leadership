/**
 * MSM Unify leadership applications: receiver.
 * Runs as a Google Apps Script web app. For each application it:
 *   1. saves the resume to a Drive folder,
 *   2. appends one row to a Sheet,
 *   3. emails the application to HR (HR_EMAIL, defined in Thanks.gs),
 *   4. sends the candidate a thank-you written for the seat they chose.
 * Thanks.gs is generated by build/build.py. Setup steps are in README.md.
 */
var CONFIG = {
  SHEET_ID: "1v5za_peLtbplmglzCSp5aNpYAah1ft4OG-1rE02Yn9A",  // "MSM Unify Leadership Applications" sheet
  SHEET_TAB: "Applications",
  FOLDER_ID: "1xSaAah8SCFWXowiJceBjfmhh6c1sHqDg",  // "MSM Unify Leadership Applications (Resumes)" folder
  MAX_BYTES: 5 * 1024 * 1024
};

function doPost(e) {
  try {
    var body = JSON.parse(e.postData.contents);
    var d = body.data || {}, r = body.resume || {};
    if (!d.name || !d.email || !d.role) return out({ ok: false, error: "Missing fields" });
    if (!THANKS[d.role]) return out({ ok: false, error: "Unknown seat" });
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(d.email)) return out({ ok: false, error: "Bad email" });
    if (r.size > CONFIG.MAX_BYTES) return out({ ok: false, error: "File too large" });

    var fileUrl = "", blob = null;
    if (r.base64) {
      blob = Utilities.newBlob(Utilities.base64Decode(r.base64), r.type, body.ref + " - " + d.name + " - " + r.name);
      fileUrl = DriveApp.getFolderById(CONFIG.FOLDER_ID).createFile(blob).getUrl();
    }

    var ss = SpreadsheetApp.openById(CONFIG.SHEET_ID);
    var sh = ss.getSheetByName(CONFIG.SHEET_TAB) || ss.insertSheet(CONFIG.SHEET_TAB);
    if (sh.getLastRow() === 0) {
      sh.appendRow(["Reference", "Submitted", "Seat", "Name", "Email", "Phone", "Location", "Title", "Company", "Experience", "Notice", "LinkedIn", "Portfolio", "Source", "First 90 days", "Resume"]);
    }
    sh.appendRow([body.ref, body.submittedAt, d.role, d.name, d.email, d.phone, d.location, d.title, d.company, d.experience, d.notice, d.linkedin, d.link || "", d.source || "", d["case"], fileUrl]);

    sendToHr(body, d, fileUrl, blob);
    sendToCandidate(body, d);
    return out({ ok: true, ref: body.ref });
  } catch (err) {
    return out({ ok: false, error: String(err) });
  }
}

function sendToHr(body, d, fileUrl, blob) {
  var rows = [["Seat", d.role], ["Name", d.name], ["Email", d.email], ["Phone", d.phone], ["Location", d.location], ["Current role", d.title + " at " + d.company],
    ["Experience", d.experience], ["Notice period", d.notice], ["LinkedIn", d.linkedin], ["Portfolio", d.link || "Not provided"], ["Heard about us", d.source || "Not provided"]];
  var table = rows.map(function (r) {
    return '<tr><td style="padding:6px 16px 6px 0;color:#666;font-size:13px;white-space:nowrap">' + esc(r[0]) + '</td><td style="padding:6px 0;font-size:14px">' + esc(r[1]) + "</td></tr>";
  }).join("");
  var html = '<div style="font-family:Poppins,Arial,sans-serif;max-width:640px;color:#111">' +
    '<div style="background:#E8252A;color:#fff;padding:18px 24px;font-weight:800;font-size:18px">New leadership application</div>' +
    '<div style="border:1px solid #efefef;border-top:0;padding:24px">' +
    '<p style="font-size:20px;font-weight:700;margin:0 0 4px">' + esc(d.name) + "</p>" +
    '<p style="margin:0 0 20px;color:#444">applied for <b>' + esc(d.role) + '</b> &middot; Ref ' + esc(body.ref) + "</p>" +
    '<table style="border-collapse:collapse">' + table + "</table>" +
    '<p style="margin:24px 0 6px;font-weight:700">What they would change in the first 90 days</p>' +
    '<div style="background:#f7f7f4;padding:16px;border-left:4px solid #E8252A;font-size:14px;line-height:1.6">' + esc(d["case"]).replace(/\n/g, "<br>") + "</div>" +
    (fileUrl ? '<p style="margin-top:20px"><a href="' + fileUrl + '" style="color:#B3121A;font-weight:700">Open resume in Drive</a></p>' : "") +
    '<p style="margin-top:24px;color:#666;font-size:12px">Acknowledge within ' + SLA_ACK_DAYS + " working days. Replying to this email writes to the candidate.</p></div></div>";
  var opts = {
    to: HR_EMAIL,
    subject: "Leadership application: " + d.role + " | " + d.name + " | " + body.ref,
    htmlBody: html,
    body: "New leadership application\n" + rows.map(function (r) { return r[0] + ": " + r[1]; }).join("\n") + "\n\nFirst 90 days:\n" + d["case"] + (fileUrl ? "\n\nResume: " + fileUrl : ""),
    replyTo: d.email,
    name: "MSM Unify careers site"
  };
  if (blob) opts.attachments = [blob];
  MailApp.sendEmail(opts);
}

function sendToCandidate(body, d) {
  var t = THANKS[d.role], first = String(d.name).split(" ")[0];
  var excerpt = String(d["case"]).replace(/\s+/g, " ").trim();
  if (excerpt.length > 220) excerpt = excerpt.slice(0, 217).replace(/\s+\S*$/, "") + "...";
  var best = d.role === "Best fit, you decide";
  var seat = best ? "a leadership seat at MSM Unify" : d.role;
  var steps = [
    "Within " + SLA_ACK_DAYS + " working days, our talent team confirms we have read your application.",
    "If there is a fit, we talk about your background and the seat.",
    "Before the final stage you speak with the Founder and Director or the hiring leader, and you receive the seat's written mandate: what you own, what success looks like in 12 months, and how you are measured.",
    "After every interview you hear the outcome within " + SLA_OUTCOME_DAYS + " working days, with one specific reason."
  ];
  var html = '<div style="font-family:Poppins,Arial,sans-serif;max-width:600px;color:#111;line-height:1.6">' +
    '<div style="background:#E8252A;padding:22px 28px;color:#fff;font-weight:800;font-size:22px;letter-spacing:-0.3px">MSM Unify</div>' +
    '<div style="border:1px solid #efefef;border-top:0;padding:32px 28px">' +
    '<p style="font-size:26px;font-weight:800;line-height:1.2;margin:0 0 16px;letter-spacing:-0.5px">' + esc(first) + ", your application is in.</p>" +
    '<p style="font-size:16px;margin:0 0 16px">Thank you for applying for <b>' + esc(seat) + "</b>. " + esc(t.lead) + "</p>" +
    '<p style="font-size:14px;color:#444;margin:0 0 20px">You wrote: <i>&ldquo;' + esc(excerpt) + "&rdquo;</i> We read that closely.</p>" +
    '<div style="background:#111;color:#fff;padding:18px 20px;margin:0 0 24px"><div style="font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#FCAF17;margin-bottom:6px">For your first conversation</div><div style="font-size:16px;font-weight:600">' + esc(t.ready) + "</div></div>" +
    '<p style="font-weight:700;margin:0 0 8px">What happens next</p>' +
    '<ol style="padding-left:20px;margin:0 0 24px;color:#333;font-size:14px">' + steps.map(function (s) { return '<li style="margin-bottom:6px">' + esc(s) + "</li>"; }).join("") + "</ol>" +
    '<p style="font-size:14px;color:#444;margin:0 0 4px">Your reference is <b>' + esc(body.ref) + "</b>. Reply to this email if you want to add anything or need an adjustment for the process.</p>" +
    '<p style="margin:20px 0 0;font-size:14px">The MSM Unify Talent Team<br><a href="https://www.msmunify.com" style="color:#B3121A">www.msmunify.com</a> | Global Education, Building Careers</p>' +
    "</div></div>";
  var text = first + ", your application is in.\n\nThank you for applying for " + seat + ". " + t.lead + "\n\nYou wrote: \"" + excerpt + "\"\n\nFor your first conversation: " + t.ready +
    "\n\nWhat happens next:\n- " + steps.join("\n- ") + "\n\nReference: " + body.ref + "\n\nThe MSM Unify Talent Team\nwww.msmunify.com | Global Education, Building Careers";
  MailApp.sendEmail({
    to: d.email,
    subject: "Your application for " + seat + " | MSM Unify",
    htmlBody: html,
    body: text,
    replyTo: HR_EMAIL,
    name: "MSM Unify Talent Team"
  });
}

function out(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }
function esc(s) { return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
